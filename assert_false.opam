opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/assert_false"
bug-reports: "https://github.com/janestreet/assert_false/issues"
dev-repo: "git+https://github.com/janestreet/assert_false.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/assert_false/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "A locatable replacement for unreachable-code assertions."
description: "
Assert_false provides helpers for marking unreachable branches with failure messages that include source locations and grep-friendly identifiers.
"
